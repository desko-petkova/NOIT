@model List<Room>
@{
    ViewData["Title"] = "Кабинети";
}

<div class="text-center">
    <h1 class="display-4">Кабинети</h1>
    <p>Информация за кабинетите в ППМГ "Акад. Никола Обрешков"</p>
</div>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Номер</th>
            <th scope="col">Име</th>
            <th scope="col">Капацитет</th>
            <th scope="col">Етаж</th>
            <th scope="col">Компютри</th>
        </tr>
    </thead>
    @foreach(var r in Model)
    {
        <tbody>
            <tr>
                <th scope="row">@r.Id</th>
                <td>@r.Number</td>
                <td>@r.Capacity</td>
                <td>@r.Floor</td>
                <td>@(r.HasComputers? "Да" : "Не")</td>
            </tr>

        </tbody>
    }
   
</table>